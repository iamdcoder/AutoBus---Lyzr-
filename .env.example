# Local development only. Never commit a real .env file or credentials.
LYZR_API_KEY=
BUYER_AGENT_ID=6aa055144dee8f87a280eb21
SUPPLIER_AGENT_ID=6aa055ad7322addc1448fa6a
LYZR_USER_ID=buyer-system

# Optional Lyzr Responsible AI custom guardrail endpoint.
# When set, governance calls fail closed if the endpoint is unavailable.
LYZR_GUARDRAIL_URL=
LYZR_GUARDRAIL_TOKEN=

# Optional AIMS-compatible event sink configured by the deployment.
LYZR_AIMS_WEBHOOK_URL=
LYZR_AIMS_TOKEN=
LYZR_GOVERNANCE_TIMEOUT=8
LYZR_CHAT_TIMEOUT=90
LYZR_AIMS_OUTBOX=data/aims_outbox.jsonl

# FastAPI/deployment settings.
CORS_ORIGINS=*
PUBLIC_BASE_URL=

# Set to 1 after enabling a Responsible AI policy on the two Lyzr agents.
LYZR_RESPONSIBLE_AI_ENABLED=1
LYZR_RAI_POLICY_ID=
LYZR_VERIFY_AGENT_FEATURES=1
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai

# Optional creation parameters for python -m agents.lyzr_bootstrap --create.
LYZR_PROVIDER_ID=
LYZR_MODEL=
LYZR_LLM_CREDENTIAL_ID=

# Prefer the Lyzr ADK Studio/Agent interface; keep Agent API fallback for resilience.
LYZR_USE_SDK=1
LYZR_SDK_FALLBACK=1
